<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build de DESENVOLVIMENTO (Debug): push no endpoint sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Group: compartilha URL/token do bridge com o widget de home screen. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.br.com.consorciolimpagyn.songpro</string>
	</array>
</dict>
</plist>
