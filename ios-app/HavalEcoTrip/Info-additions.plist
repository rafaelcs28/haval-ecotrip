<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trechos pra somar no Info.plist DO APP PRINCIPAL (não do widget).
  No Xcode: abra o Info.plist do target HavalEcoTrip e adicione as chaves
  abaixo. Sem isso o iOS recusa criar Live Activity ("activitiesEnabled
  is false").
-->
<plist version="1.0">
<dict>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
</dict>
</plist>
