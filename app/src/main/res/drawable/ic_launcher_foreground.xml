<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        SURGE — Raio tricolor: verde (energia) → teal (eficiência) → laranja (combustível)
        Safe zone: 18..90 em x e y (36dp raio centrado em 54,54)
        Raio: x ≈ 40.6..71.6, y ≈ 20..89.3  (tudo dentro do safe zone)
    -->
    <path
        android:pathData="M50,20 L71.6,20 L61.1,53.4 L68.6,53.4 L47.9,89.3 L40.6,89.3 L50,53.4 L42.4,53.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                xmlns:gradient="http://schemas.android.com/apk/res/android"
                android:startX="54" android:startY="20"
                android:endX="54"   android:endY="89"
                android:type="linear">
                <item android:offset="0"    android:color="#FF39FF88"/>
                <item android:offset="0.42" android:color="#FF00E5CC"/>
                <item android:offset="1"    android:color="#FFFF5F1F"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gota de combustível (laranja) — canto inferior direito do safe zone -->
    <path
        android:pathData="M82,74 Q82,66 77,64.5 Q72,66 72,74 Q72,81.5 77,83 Q82,81.5 82,74 Z"
        android:fillColor="#CCFF5F1F"/>

    <!-- Faísca (verde) — canto superior esquerdo do safe zone -->
    <path
        android:pathData="M30,22 L27,27.5 L32.5,26 L30,31.5 L35.5,29 L32,35 L28,29 L33.5,27 Z"
        android:fillColor="#BB39FF88"/>

</vector>
