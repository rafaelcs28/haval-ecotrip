# =========================================================================
# EcoTrip Bridge — .env de exemplo
# Copie: cp .env.example .env  ·  NUNCA commite o .env real.
# =========================================================================


# ── MQTT (obrigatório) ──────────────────────────────────────────────────
# Broker que recebe a telemetria do APK e que o bridge subscreve.
# Tipicamente um Mosquitto local, do Home Assistant, ou serviço gerenciado.
# Exemplos: mqtt://192.168.1.10  ·  mqtts://broker.exemplo.com  ·  mqtt://localhost
MQTT_HOST=mqtt://SEU_BROKER_AQUI
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Mesmo prefix configurado no APK em Settings → MQTT
MQTT_PREFIX=haval/ecotrip


# ── HTTP / HTTPS ────────────────────────────────────────────────────────
PORT=3000
HTTPS_PORT=3443


# ── Identificação do veículo (obrigatório) ─────────────────────────────
# Chassi do carro em minúsculas — usado pra subscrever os tópicos do
# integration GWM Brasil no Home Assistant (gwmbrasil_<chassi>/<id>/state).
# Procure no documento do carro ou no app GWM Brasil.
GWM_CHASSI=


# ── Home Assistant (opcional) ──────────────────────────────────────────
# Usado pra puxar estados iniciais via REST quando o bridge inicia, antes
# de receber a primeira mensagem MQTT. Sem isso, a UI demora alguns
# segundos pra popular. Deixe em branco se não usa HA.
HA_URL=
HA_TOKEN=


# ── Senha de acesso à PWA (recomendado em produção) ────────────────────
# Se vazio, o bridge fica aberto — use só em dev local.
# Gere uma senha forte:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use em texto puro — o bridge calcula o hash automaticamente.
BRIDGE_TOKEN=

# Alternativa: hash SHA-256 direto (gerado pelo /api/admin/change-password).
# Tem precedência sobre BRIDGE_TOKEN.
# BRIDGE_TOKEN_HASH=

# Token separado pra /api/admin/*. Vazio = usa o BRIDGE_TOKEN.
ADMIN_TOKEN=


# ── Login Google (opcional) ────────────────────────────────────────────
# Habilita botão "Entrar com Google" no PWA, em paralelo ao login por senha.
# Criar Client ID: https://console.cloud.google.com → APIs e serviços →
# Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Origens JavaScript autorizadas: as URLs onde o PWA é acessado.
GOOGLE_OAUTH_CLIENT_ID=

# CSV de emails autorizados (whitelist). Vazio = aceita qualquer email
# com verificação Google — não recomendado em prod.
GOOGLE_ALLOWED_EMAILS=


# ── Push Notifications (chaves VAPID, opcional) ────────────────────────
# Geradas automaticamente no primeiro boot e salvas em vapid.json.
# Sobrescreva aqui só se quiser sincronizar chaves entre máquinas.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
