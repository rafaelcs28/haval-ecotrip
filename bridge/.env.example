# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# Endereço do broker MQTT (com protocolo)
# Exemplos: mqtt://192.168.1.10  |  mqtts://meubroker.com  |  mqtt://localhost
MQTT_HOST=mqtt://SEU_BROKER_AQUI

# Porta MQTT (padrão: 1883; com TLS: 8883)
MQTT_PORT=1883

# Credenciais do broker (deixe em branco se não usar)
MQTT_USER=
MQTT_PASS=

# Prefixo dos tópicos (igual ao configurado no app do carro)
MQTT_PREFIX=haval/ecotrip

# Porta do servidor web desta bridge
PORT=3000

# Senha de acesso à PWA e à API
# Se vazio, o servidor fica aberto (útil para desenvolvimento local)
# Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BRIDGE_TOKEN=

# Token para endpoints administrativos (/api/admin/*)
# Se vazio, usa o BRIDGE_TOKEN acima (recomendado — uma senha só)
# Defina apenas se quiser tokens separados (ex: dev acessa dados mas não apaga)
ADMIN_TOKEN=
