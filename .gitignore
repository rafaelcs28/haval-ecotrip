# Secrets e estado runtime do bridge — nunca commitar
.env
bridge/.env
bridge/.env.*
# Chaves .p8 (APNs + App Store Connect API) — NUNCA commitar
*.p8
**/*.p8
# Multi-tenant: dados + .env de cada pessoa hospedada (segredos, dados pessoais) — NUNCA commitar
bridge/tenants/
bridge/*.bak
bridge/*.bak.*
bridge/*.bak-*
bridge/state.json.bak*
bridge/diag_state.json
bridge/diag_log.json
bridge/notif_prefs_by_device.json
bridge/notif_history.json
bridge/auth.json
bridge/cert.pem
bridge/key.pem
bridge/*.pem
# Dados pessoais runtime — não compartilhar (o servidor recria vazios no 1º boot)
bridge/drive_history.json
bridge/preclimat.json
bridge/songpro.json
bridge/songpro_charges.json
bridge/songpro_locations.json
bridge/automation_rules.json
bridge/automation_places.json
bridge/speed_fence.json
bridge/share_tokens.json
bridge/activity_tokens.json
# Scripts de teste pontuais (lêem o .env real) — não versionar
bridge/_test_*.js

# Artefatos de build/archive do iOS
ios-app/build/
*.xcarchive

# análise de apps de referência (não versionar)
_analise/

# Simulador da tela Controles (não vai pro APK)
app/src/main/assets/controles/_sim.html
app/src/main/assets/controles/_debug.js

# Atalhos com token do bridge embutido (não vão pro repo público)
ios-app/AutoShareLocal.shortcut
ios-app/AutoShareReady.shortcut
